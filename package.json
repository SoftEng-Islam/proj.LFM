{
	"name": "lfm",
	"description": "LFM is a Linux-first desktop file manager built with Vue, TypeScript, Rust, Tauri, Tailwind CSS, and Sass.",
	"version": "0.4.0",
	"packageManager": "pnpm@10.14.0",
	"author": "Islam Ahmed <softeng.islam@gmail.com>",
	"icon": "src-tauri/icons/icon.png",
	"private": true,
	"homepage": "https://github.com/softeng/proj.LFM",
	"repository": {
		"type": "git",
		"url": "https://github.com/softeng/proj.LFM.git"
	},
	"os": [
		"linux"
	],
	"engines": {
		"node": ">=20.19.0",
		"pnpm": ">=10.14.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@apollo/protobufjs",
			"@parcel/watcher",
			"argon2",
			"esbuild",
			"vue-demi"
		]
	},
	"scripts": {
		"dev": "tauri dev",
		"dev:ui": "vite",
		"build": "pnpm run type-check && pnpm run clean && pnpm run build:web && tauri build",
		"build:web": "vite build",
		"build:analyze": "ANALYZE=true vite build",
		"preview": "vite preview",
		"type-check": "vue-tsc --noEmit -p tsconfig.app.json",
		"check": "pnpm run type-check && pnpm run lint",
		"docs": "pnpm --dir ./docs run start",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"copyfiles": "node scripts/copyfiles.js",
		"crowdin": "crowdin",
		"crowdin:pull": "crowdin pull",
		"postcrowdin:pull": "node scripts/post_crowdin_pull.js",
		"crowdin:sync": "pnpm --dir ./docs run write-translations && crowdin upload && crowdin download",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"clean": "rimraf dist",
		"clean:cache": "rimraf .vite node_modules/.vite",
		"fakefiles": "python3 scripts/generate-fake-files.py 1000"
	},
	"keywords": [
		"LFM",
		"Linux",
		"File manager",
		"Desktop",
		"Tauri"
	],
	"license": "GPL-3.0-only",
	"devDependencies": {
		"@crowdin/cli": "^3.19.4",
		"@iconify-json/material-symbols": "^1.2.70",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/cli": "^2.11.0",
		"@types/dompurify": "^3.2.0",
		"@types/node": "^25.6.0",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"@vue/compiler-sfc": "^3.5.33",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.7.0",
		"@vue/test-utils": "^2.4.10",
		"autoprefixer": "^10.5.0",
		"concurrently": "^9.2.1",
		"cpy": "^8.1.2",
		"daisyui": "^5.5.19",
		"eslint": "^10.2.1",
		"eslint-plugin-vue": "~10.8.0",
		"happy-dom": "^20.9.0",
		"node-watch": "^0.7.4",
		"postcss": "^8.5.13",
		"prettier": "3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"pug": "^3.0.4",
		"pug-plain-loader": "^1.1.0",
		"rimraf": "^6.1.3",
		"rollup-plugin-visualizer": "^7.0.1",
		"sass": "^1.99.0",
		"tailwindcss": "^4.2.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.1",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.10",
		"vite-plugin-imagemin": "^0.6.1",
		"vite-plugin-pug": "^0.4.1",
		"vite-plugin-vue-devtools": "^8.1.1",
		"vite-svg-loader": "^5.1.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.5",
		"vue-pug-plugin": "^2.0.4",
		"vue-tsc": "^3.2.7"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@videojs-player/vue": "^1.0.0",
		"@vueuse/core": "^14.2.1",
		"@vueuse/motion": "^3.0.3",
		"@xterm/xterm": "^6.0.0",
		"animate.css": "^4.1.1",
		"dompurify": "^3.4.2",
		"highlight.js": "^11.11.1",
		"mammoth": "^1.12.0",
		"marked": "^4.3.0",
		"pdfjs-dist": "^5.7.284",
		"pinia": "^3.0.4",
		"tippy.js": "^6.3.7",
		"video.js": "^8.23.7",
		"vue": "^3.5.33",
		"vue-router": "^5.0.4",
		"vue-toastification": "2.0.0-rc.5",
		"vue-virtual-scroller": "^2.0.0-beta.8",
		"xlsx": "^0.17.5"
	}
}
