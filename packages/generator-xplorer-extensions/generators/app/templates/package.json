{
	"name": "<%= extensionIdentifier %>",
	"extensionName": "<%= extensionName %>",
	"description": "My Extension Description",
	"category": "<%= extensionType %>",
	"version": "0.1.0",
	"license": "MIT",
	"scripts": {
		"start": "Files --theme <%= extensionIdentifier %>",
		"build": "Files extensions theme build",
		"Files:install": "Files extensions theme install"
	},
	"FilesExtensionConfig": {
		"themes": [
			{
				"identifier": "<%= extensionIdentifier %>",
				"name": "<%= extensionName %>",
				"path": "./themes/<%= extensionIdentifier%>-color-theme.json"
			}
		]
	}
}